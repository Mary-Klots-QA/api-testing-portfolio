  "item": [
    {
      "name": "Get all users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time under 1 second\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test(\"Response has data array\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data).to.be.an('array');",
              "    pm.expect(body.data.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"First user has an email\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data[0].email).to.include('@');",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "free_user_3DczDxFp1kXcF5ZCwm4G43LauZG",
            "type": "text"
