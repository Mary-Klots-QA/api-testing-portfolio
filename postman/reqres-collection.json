    {
      "name": "Create user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"newUserId\", pm.response.json().id);",
              "pm.test(\"TC01: Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"TC01: Response has id\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.exist;",
              "    pm.expect(body.name).to.equal(\"Jane Test\");",
              "    pm.expect(body.job).to.equal(\"Senior QA Engineer\");",
              "    pm.expect(body.createdAt).to.be.a('string');",
              "});",
              "",
              "pm.test(\"TC18: Response has all expected fields\", () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b).to.have.property('id');",
              "    pm.expect(b).to.have.property('name');",
              "    pm.expect(b).to.have.property('job');",
              "    pm.expect(b).to.have.property('createdAt');",
              "});",
              "",
              "pm.test(\"TC19: id is a string\", () => {",
              "    pm.expect(pm.response.json().id).to.be.a('string');",
              "});",
              "",
              "pm.test(\"TC20: createdAt is ISO format\", () => {",
              "    const ts = pm.response.json().createdAt;",
              "    pm.expect(new Date(ts).toString()).to.not.equal('Invalid Date');",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
