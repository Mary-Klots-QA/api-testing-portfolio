    {
      "name": "Rate limiting n sensetive data test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 429) {",
              "    pm.test(\"Rate limit response has Retry-After header\", function () {",
              "        pm.expect(pm.response.headers.get(\"Retry-After\")).to.exist;",
              "    });",
              "}",
              "pm.test(\"Response does not expose sensitive fields\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.not.have.property('password');",
              "    pm.expect(body).to.not.have.property('passwordHash');",
              "    pm.expect(body).to.not.have.property('secretKey');",
              "    pm.expect(JSON.stringify(body)).to.not.include('password');",
              "});"
            ],
            "type": "text/javascript",
